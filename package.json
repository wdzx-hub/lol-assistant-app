{
  "name": "lol-assistant-app",
  "version": "1.0.0",
  "description": "英雄联盟游戏辅助器（独立桌面应用 + 游戏内悬浮提示）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lol.assistant",
    "productName": "LOL助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LOL助手"
    }
  }
}
